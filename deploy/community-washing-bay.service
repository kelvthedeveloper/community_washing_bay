[Unit]
Description=Community Washing Bay Django application
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/community-washing-bay/backend
EnvironmentFile=/etc/community-washing-bay/app.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
RuntimeDirectory=community-washing-bay
RuntimeDirectoryMode=0750
UMask=0077
ExecStartPre=/srv/community-washing-bay/backend/.venv/bin/python manage.py createcachetable django_cache
ExecStart=/srv/community-washing-bay/backend/.venv/bin/gunicorn config.wsgi:application --bind unix:/run/community-washing-bay/gunicorn.sock --workers 3 --access-logfile - --error-logfile - --timeout 60
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/community-washing-bay/backend/private_media

[Install]
WantedBy=multi-user.target
